{
  "name": "omp_hub_client",
  "version": "0.1.3",
  "description": "DAP/1 hub client extension for oh-my-pi: channels, DM, presence, invites as tools + /dap commands + footer status",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vabhzw17eg2qu4m9-bit/omp_hub_client.git"
  },
  "bugs": {
    "url": "https://github.com/vabhzw17eg2qu4m9-bit/omp_hub_client/issues"
  },
  "homepage": "https://github.com/vabhzw17eg2qu4m9-bit/omp_hub_client#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "omp",
    "oh-my-pi",
    "dap",
    "agents",
    "websocket",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=text-summary tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "c8": "^10.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
